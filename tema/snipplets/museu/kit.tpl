{# MUSEU EM FIOS — o que vem no kit (responde às objeções
   "vem tudo o que eu preciso?" e "e se eu travar no meio?") #}

<section class="mf-kit" id="kit">
    <div class="mf-wrap">
        <div class="mf-kit__visual" data-reveal>
            <div class="mf-kit__fio" data-fio></div>
            <img src="{{ 'images/obras/klimt-der-kuss-sq.jpg' | static_url }}" alt="Detalhe da obra Der Kuss, de Gustav Klimt" loading="lazy">
        </div>
        <div>
            <p class="mf-eyebrow" data-reveal>O que vem no kit</p>
            <h2 class="mf-h2" data-reveal>Tudo o que você<br>precisa para começar</h2>
            <ul class="mf-kit__lista" data-reveal="grupo">
                <li><span class="num">01</span> Tela de 20x20 com o risco da obra impresso e fixado</li>
                <li><span class="num">02</span> Meadas Anchor Mouliné na paleta do artista</li>
                <li><span class="num">03</span> Agulha, estojo de algodão cru e tesoura de arremate</li>
                <li><span class="num">04</span> Postal da obra original com certificado de autenticidade</li>
                <li><span class="num">05</span> QR code para o guia passo a passo, detalhado e fotografado etapa por etapa</li>
            </ul>
            <p class="mf-kit__nota" data-reveal>Travou em algum ponto? A gente
            destrava com você — guia com foto de cada passo e atendimento
            direto no WhatsApp.</p>
            <a class="mf-btn" href="/kits-de-bordado/" data-reveal>Escolher meu kit</a>
        </div>
    </div>
</section>
